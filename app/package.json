{
  "name": "@estoc/app",
  "version": "0.1.0",
  "description": "The Estoc app, built: the static files of the offline-first DIDComm v2 messenger (app.estoc.dev), for anything that wants to serve them itself — `estoc serve` / `estoc-daemon` do.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "app"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-entry/index.d.ts",
      "default": "./dist-entry/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-entry"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/entry.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc -b",
    "icons": "node scripts/icons.mjs",
    "e2e": "node scripts/e2e.mjs",
    "deploy": "pnpm -w run deploy",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@estoc/agent-core": "workspace:^",
    "@estoc/daemon": "workspace:^",
    "@estoc/folder-object": "workspace:^",
    "@estoc/keystore": "workspace:^",
    "@estoc/post": "workspace:^",
    "@estoc/vault": "workspace:^",
    "@vitejs/plugin-vue": "^5.2.0",
    "didcomm": "^0.4.1",
    "fflate": "^0.8.2",
    "playwright-core": "^1.62.1",
    "qrcode-generator": "^2.0.4",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0",
    "workbox-window": "^7.4.1"
  },
  "keywords": [
    "didcomm",
    "did",
    "messenger",
    "pwa",
    "decentralized-identity"
  ]
}
