{
  "name": "@estoc/event-store",
  "version": "0.1.0",
  "description": "The vault as an event store (docs/event-store.md): the event envelope, canonical order and filter; the EventStore, BlobStore and FileStore interfaces every Estoc vault store implements; in-memory stores for tests and folds; the interchange (snapshot, export, import, restore, zip). Knows no event type: what an event means is @estoc/vault's.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/event-store"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "keywords": [
    "estoc",
    "vault",
    "event-store",
    "event-sourcing",
    "opfs",
    "decentralized-identity",
    "dasl"
  ],
  "dependencies": {
    "@estoc/dasl": "workspace:^",
    "fflate": "^0.8.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@estoc/folder-object": "workspace:^",
    "@types/node": "^22.20.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.62.1",
    "multiformats": "^14.0.5"
  }
}
