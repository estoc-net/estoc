{
  "name": "@estoc/event-store",
  "version": "0.2.0",
  "description": "The vault as an event store (docs/replica-model): canonical JSON, the event envelope, canonical order and filter; the EventStore, ObjectStore and Vault interfaces and their in-memory reference; the SQLite vault on Node and in a browser Worker; the portable snapshot's export, validation, restore and import. Knows no event type: what an event means is @estoc/vault's.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/event-store"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "keywords": [
    "estoc",
    "vault",
    "event-store",
    "event-sourcing",
    "opfs",
    "decentralized-identity",
    "sqlite",
    "dasl"
  ],
  "dependencies": {
    "@estoc/dasl": "workspace:^",
    "@noble/hashes": "^1.8.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "canonicalize": "^5.1.0",
    "jsonc-parser": "^3.3.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@estoc/keystore": "workspace:^",
    "@types/chai": "^5.2.2",
    "@types/node": "^22.20.1",
    "@vitest/expect": "3.2.7",
    "chai": "^5.3.3",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.62.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7"
  }
}
