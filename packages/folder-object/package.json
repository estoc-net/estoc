{
  "name": "@estoc/folder-object",
  "version": "0.7.0",
  "description": "An object is a folder: the folder-object format over DASL \u2014 a MASL manifest hashed as one DRISL block, files as whole raw blocks (read, validate, hash, verify), did:key object cards (sign, verify), and the signed-object layout. Pure functions, no IO; runs in Node, workerd, and the browser.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/folder-object"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "default": "./dist/fs.js"
    },
    "./zip": {
      "types": "./dist/zip.d.ts",
      "default": "./dist/zip.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@estoc/dasl": "workspace:^",
    "@estoc/keystore": "workspace:^",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0",
    "multiformats": "^14.0.5",
    "@ipld/dag-cbor": "10.0.2"
  },
  "keywords": [
    "folder-object",
    "dasl",
    "drisl",
    "cid",
    "content-addressing",
    "did"
  ]
}
