{
  "name": "@estoc/folder-object",
  "version": "0.4.0",
  "description": "An object is a folder: UnixFS merkle hashing (IPIP-499 unixfs-v1-2025), the folder-object format (read, validate, hash), did:key object cards (sign, verify), and the signed-object layout. Pure functions, no IO; runs in Node, workerd, and the browser.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/folder-object"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "default": "./dist/fs.js"
    },
    "./zip": {
      "types": "./dist/zip.d.ts",
      "default": "./dist/zip.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@estoc/keystore": "workspace:^",
    "fflate": "^0.8.2",
    "ipfs-unixfs-exporter": "^16.0.2",
    "ipfs-unixfs-importer": "^17.0.1",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@ipld/dag-pb": "^4.1.7",
    "@types/node": "^22.13.5",
    "ipfs-unixfs": "^13.0.0",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "folder-object",
    "unixfs",
    "cid",
    "merkle",
    "content-addressing",
    "did"
  ]
}
