{
  "name": "@estoc/signed-dir",
  "version": "0.2.0",
  "description": "Owner-signed directory trees: IPLD-notation merkle hashing (raw file CIDs + dag-json dir nodes) and the signed root card. Pure functions, no IO; runs in Node, workerd, and the browser.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/signed-dir"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@ipld/dag-json": "^11.0.1",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "merkle",
    "ipld",
    "cid",
    "signed-directory",
    "content-addressing"
  ]
}
