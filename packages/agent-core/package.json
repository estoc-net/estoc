{
  "name": "@estoc/agent-core",
  "version": "0.18.0",
  "description": "The DIDComm v2 agent behind Estoc's clients: mediation, pickup, live delivery, pairwise DIDs, invitations and object sharing over an .estoc vault (@estoc/event-store + @estoc/vault: an append-only event log folded into contacts, channels and messages, through a pluggable VaultBackend). Runs wherever didcomm-rust's WASM does.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/agent-core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "default": "./dist/v3/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "keywords": [
    "didcomm",
    "did",
    "agent",
    "opfs",
    "decentralized-identity"
  ],
  "dependencies": {
    "@estoc/did-peer": "workspace:^",
    "@noble/curves": "^1.9.7",
    "@estoc/event-store": "workspace:^",
    "@estoc/folder-object": "workspace:^",
    "@estoc/keystore": "workspace:^",
    "@estoc/vault": "workspace:^",
    "bs58": "^6.0.0",
    "did-resolver": "^4.1.0",
    "ipaddr.js": "^2.5.0",
    "multiformats": "^14.0.5",
    "uuid": "^11.1.1",
    "web-did-resolver": "^2.0.32"
  },
  "peerDependencies": {
    "@estoc/didcomm": "^0.4.1-estoc.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "didcomm-node": "^0.4.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7",
    "@estoc/didcomm": "^0.4.1-estoc.2",
    "@estoc/didcomm-node": "^0.4.1-estoc.2",
    "jose": "^6.0.0"
  }
}
