{
  "name": "@estoc/agent-core",
  "version": "0.17.0",
  "description": "The DIDComm v2 agent behind Estoc's clients: mediation, pickup, live delivery and hand-layered packing over an .estoc vault (@estoc/vault: config, seed keystore, contacts, append-only message log, through a pluggable VaultBackend). Runs wherever didcomm-rust's WASM does.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/agent-core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "keywords": [
    "didcomm",
    "did",
    "agent",
    "opfs",
    "decentralized-identity"
  ],
  "dependencies": {
    "@estoc/did-peer": "workspace:^",
    "@estoc/event-store": "workspace:^",
    "@estoc/folder-object": "workspace:^",
    "@estoc/keystore": "workspace:^",
    "@estoc/vault": "workspace:^",
    "bs58": "^6.0.0",
    "did-resolver": "^4.1.0",
    "web-did-resolver": "^2.0.32"
  },
  "peerDependencies": {
    "didcomm": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "didcomm-node": "^0.4.1",
    "typescript": "~5.8.0",
    "vitest": "^3.2.7",
    "didcomm": "^0.4.1"
  }
}
