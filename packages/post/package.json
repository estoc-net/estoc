{
  "name": "@estoc/post",
  "version": "0.1.0",
  "description": "The post/1.0 type format for folder-objects: recognise, validate and read a post's vocabulary, and project it — the reference renderer (CommonMark body → HTML fragment, in-tree references resolved, raw HTML dropped). Pure functions, no IO; runs in Node, workerd, and the browser.",
  "license": "Apache-2.0",
  "author": "merely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estoc-net/estoc.git",
    "directory": "packages/post"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@estoc/folder-object": "workspace:^",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "folder-object",
    "post",
    "markdown",
    "renderer"
  ]
}
